# P1 全栈部署环境变量模板（docker-compose-fullstack.yml）
# 用法：cp docker/.env.example docker/.env && 按需填写，然后：
#   docker compose -f docker/docker-compose-fullstack.yml --env-file docker/.env up -d

# ===== 必填（应用启动硬依赖）=====
# Jasypt 配置加密主密钥
JASYPT_MASTER_PASSWORD=change-me
# PostgreSQL 密码（容器初始化与应用连接共用）
DB_PASSWORD=aether
# JWT 签名密钥（>=32 字符；生产必须更换）
JWT_SECRET=dev-only-jwt-secret-key-min-32-chars!!

# ===== 可选 =====
# 记忆 Embedding（智谱；不填则语义检索降级为时间排序）
ZHIPU_API_KEY=
# Grafana 管理员
GRAFANA_USER=admin
GRAFANA_PASSWORD=aether
